    {
      "name": "Search students by course",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/students?course=Python",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "students"
          ],
          "query": [
            {
              "key": "course",
              "value": "Python"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('all Python', () => pm.response.json().forEach(s => pm.expect(s.course).to.eql('Python')));"
            ]
          }
        }
      ]
    },
