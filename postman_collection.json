  "item": [
    {
      "name": "Add student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"ravi.kumar@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"age\": 22,\n  \"course\": \"Python\",\n  \"address\": \"Nellore, Andhra Pradesh\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('student_id', pm.response.json().student_id);"
            ]
          }
        }
      ]
    },
